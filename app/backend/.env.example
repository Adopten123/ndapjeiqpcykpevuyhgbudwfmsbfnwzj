# Только пример. Настоящие реквизиты сохраняйте вне Git.
# Приложение не загружает этот файл автоматически; задайте окружение процесса.
RZD_DATABASE_URL=postgres://USER:YOUR_PASSWORD@127.0.0.1:55432/rzd_arctica_demo?sslmode=disable
RZD_COMPUTE_URL=http://127.0.0.1:8091
RZD_SIMULATOR_URL=http://127.0.0.1:8094
RZD_HTTP_ADDR=127.0.0.1:8090
# Обязателен абсолютный путь к private-конфигурации генератора demo-auth.
# Замените обозначение своим путём. Ключи и token_sha256 в этот пример не добавляйте.
RZD_AUTH_FILE=ABSOLUTE_PATH_TO_REPOSITORY/.local/approval-auth.private.json
