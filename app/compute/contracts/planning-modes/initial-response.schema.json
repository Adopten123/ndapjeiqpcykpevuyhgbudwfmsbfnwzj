{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:proarctic:planning:initial:v1:response",
  "title": "Результат начального расчёта, рабочая детализация",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "planning-initial.v1"
    },
    "data_mode": {
      "const": "demo"
    },
    "calculation_id": {
      "$ref": "urn:proarctic:replan:v1:common#/$defs/id"
    },
    "attempt_id": {
      "$ref": "urn:proarctic:replan:v1:common#/$defs/id"
    },
    "snapshot_id": {
      "$ref": "urn:proarctic:replan:v1:common#/$defs/id"
    },
    "policy_id": {
      "const": "initial-lex.v1"
    },
    "outcome": {
      "enum": [
        "with_candidate",
        "no_candidate"
      ]
    },
    "candidate_stage": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        {
          "type": "null"
        }
      ]
    },
    "solver_status": {
      "enum": [
        "OPTIMAL",
        "FEASIBLE",
        "UNKNOWN",
        "INFEASIBLE"
      ]
    },
    "candidate": {
      "anyOf": [
        {
          "$ref": "urn:proarctic:replan:v1:common#/$defs/plan"
        },
        {
          "type": "null"
        }
      ]
    },
    "party_metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "party_id": {
            "$ref": "urn:proarctic:replan:v1:common#/$defs/id"
          },
          "candidate_receipt_tick": {
            "$ref": "urn:proarctic:replan:v1:common#/$defs/tick"
          },
          "due_tick": {
            "$ref": "urn:proarctic:replan:v1:common#/$defs/tick"
          },
          "remaining_tick": {
            "$ref": "urn:proarctic:replan:v1:common#/$defs/nonnegative"
          },
          "selected_window_id": {
            "$ref": "urn:proarctic:replan:v1:common#/$defs/id"
          }
        },
        "required": [
          "party_id",
          "candidate_receipt_tick",
          "due_tick",
          "remaining_tick",
          "selected_window_id"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "objective": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "sum_remaining_tick": {
              "$ref": "urn:proarctic:replan:v1:common#/$defs/nonnegative"
            },
            "last_remaining_tick": {
              "$ref": "urn:proarctic:replan:v1:common#/$defs/nonnegative"
            }
          },
          "required": [
            "sum_remaining_tick",
            "last_remaining_tick"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "optimization_stages": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "urn:proarctic:replan:v1:common#/$defs/stage"
          },
          {
            "properties": {
              "tier": {
                "maximum": 2
              }
            }
          }
        ]
      },
      "minItems": 1,
      "maxItems": 2
    },
    "proven_prefix": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "validation": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "candidate_requires_go_check",
            "no_candidate"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "urn:proarctic:replan:v1:common#/$defs/text"
          },
          "minItems": 0
        }
      },
      "required": [
        "status",
        "notes"
      ],
      "additionalProperties": false
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "urn:proarctic:replan:v1:common#/$defs/text"
      },
      "minItems": 0
    },
    "assumptions": {
      "type": "array",
      "items": {
        "$ref": "urn:proarctic:replan:v1:common#/$defs/text"
      },
      "minItems": 0
    },
    "algorithm": {
      "type": "object",
      "properties": {
        "name": {
          "const": "cp-sat-initial"
        },
        "version": {
          "$ref": "urn:proarctic:replan:v1:common#/$defs/text"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "timing": {
      "type": "object",
      "properties": {
        "elapsed_ms": {
          "anyOf": [
            {
              "$ref": "urn:proarctic:replan:v1:common#/$defs/nonnegative"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "elapsed_ms"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contract_version",
    "data_mode",
    "calculation_id",
    "attempt_id",
    "snapshot_id",
    "policy_id",
    "outcome",
    "candidate_stage",
    "solver_status",
    "candidate",
    "party_metrics",
    "objective",
    "optimization_stages",
    "proven_prefix",
    "validation",
    "warnings",
    "assumptions",
    "algorithm",
    "timing"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "with_candidate"
          }
        }
      },
      "then": {
        "properties": {
          "candidate": {
            "$ref": "urn:proarctic:replan:v1:common#/$defs/plan"
          },
          "party_metrics": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "party_id": {
                  "$ref": "urn:proarctic:replan:v1:common#/$defs/id"
                },
                "candidate_receipt_tick": {
                  "$ref": "urn:proarctic:replan:v1:common#/$defs/tick"
                },
                "due_tick": {
                  "$ref": "urn:proarctic:replan:v1:common#/$defs/tick"
                },
                "remaining_tick": {
                  "$ref": "urn:proarctic:replan:v1:common#/$defs/nonnegative"
                },
                "selected_window_id": {
                  "$ref": "urn:proarctic:replan:v1:common#/$defs/id"
                }
              },
              "required": [
                "party_id",
                "candidate_receipt_tick",
                "due_tick",
                "remaining_tick",
                "selected_window_id"
              ],
              "additionalProperties": false
            },
            "minItems": 4,
            "maxItems": 4
          },
          "objective": {
            "type": "object",
            "properties": {
              "sum_remaining_tick": {
                "$ref": "urn:proarctic:replan:v1:common#/$defs/nonnegative"
              },
              "last_remaining_tick": {
                "$ref": "urn:proarctic:replan:v1:common#/$defs/nonnegative"
              }
            },
            "required": [
              "sum_remaining_tick",
              "last_remaining_tick"
            ],
            "additionalProperties": false
          },
          "candidate_stage": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2
          },
          "solver_status": {
            "enum": [
              "OPTIMAL",
              "FEASIBLE"
            ]
          },
          "validation": {
            "type": "object",
            "properties": {
              "status": {
                "const": "candidate_requires_go_check"
              },
              "notes": {
                "type": "array",
                "items": {
                  "$ref": "urn:proarctic:replan:v1:common#/$defs/text"
                },
                "minItems": 0
              }
            },
            "required": [
              "status",
              "notes"
            ],
            "additionalProperties": false
          }
        }
      },
      "else": {
        "properties": {
          "candidate": {
            "type": "null"
          },
          "candidate_stage": {
            "type": "null"
          },
          "party_metrics": {
            "maxItems": 0
          },
          "objective": {
            "type": "null"
          },
          "solver_status": {
            "enum": [
              "UNKNOWN",
              "INFEASIBLE"
            ]
          },
          "proven_prefix": {
            "const": 0
          },
          "validation": {
            "type": "object",
            "properties": {
              "status": {
                "const": "no_candidate"
              },
              "notes": {
                "type": "array",
                "items": {
                  "$ref": "urn:proarctic:replan:v1:common#/$defs/text"
                },
                "minItems": 0
              }
            },
            "required": [
              "status",
              "notes"
            ],
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
